  - family-names: Nicoletti
    given-names: Rodrigo
    affiliation: "University of Sao Paulo, Sao Carlos School of Engineering"
keywords:
  - rotordynamics
  - wave propagation
  - band gap
  - periodic structures
  - Bloch-Floquet
references:
